# Port to listen on. Render injects PORT automatically; this is for local dev.
PORT=4000

# Comma-separated list of origins allowed to connect (CORS + Socket.IO).
# Local development:
CORS_ORIGIN=http://localhost:3000
# Production example:
# CORS_ORIGIN=https://xeetcode.vercel.app

# Postgres connection string (Neon). A real credential — never commit it.
# Optional: without it the server serves problems from the bundled bank, so
# local development works with no database at all.
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Optional: judge against a self-hosted Piston instance instead of the local
# sandboxed process. The public emkc.org API is whitelist-only since Feb 2026.
# PISTON_URL=https://your-piston-host/api/v2/piston/execute
